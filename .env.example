# Copy to .env and adjust. .env is gitignored.

POSTGRES_USER=lawsearch
POSTGRES_PASSWORD=lawsearch
POSTGRES_DB=lawsearch
POSTGRES_PORT=5432

DATABASE_URL=postgresql://lawsearch:lawsearch@localhost:5432/lawsearch

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Local GPU embedding model. EMBEDDING_DIM must match migrations/001_init.sql.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16

# Model + dataset download cache (A2AJ parquet lands here too). Point at a roomy drive;
# unset = HuggingFace default under the user profile.
HF_HOME=D:\LawSearch\hf

# FILAC briefs. claude-cli runs `claude -p` on the Claude Code CLI's own login (for local
# testing on a subscription); api uses ANTHROPIC_API_KEY. Prompt, schema and cache are shared.
FILAC_BACKEND=claude-cli
FILAC_MODEL=claude-opus-5
FILAC_EFFORT=high

# Only needed with FILAC_BACKEND=api. Get from console.anthropic.com.
ANTHROPIC_API_KEY=

# Needed from Phase 7. Apply via the CanLII feedback form.
CANLII_API_KEY=
