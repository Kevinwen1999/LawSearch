# Copy to .env and adjust. .env is gitignored.

POSTGRES_USER=lawsearch
POSTGRES_PASSWORD=lawsearch
POSTGRES_DB=lawsearch
POSTGRES_PORT=5432

DATABASE_URL=postgresql://lawsearch:lawsearch@localhost:5432/lawsearch

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Local GPU embedding model. EMBEDDING_DIM must match migrations/001_init.sql.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16

# Model + dataset download cache (A2AJ parquet lands here too). Point at a roomy drive;
# unset = HuggingFace default under the user profile.
HF_HOME=D:\LawSearch\hf

# Downloaded source data (Justice Laws XML clone, Constitution HTML).
DATA_DIR=D:\LawSearch\data

# FILAC briefs. claude-cli runs `claude -p` on the Claude Code CLI's own login (for local
# testing on a subscription); api uses ANTHROPIC_API_KEY; lmstudio uses a local model served by
# LM Studio. Prompt, schema and cache are shared across all three.
FILAC_BACKEND=claude-cli
FILAC_MODEL=claude-opus-5
FILAC_EFFORT=high

# If FILAC_BACKEND/MODEL fails (only matters if you set it to lmstudio — a down local server
# falls back to this instead of failing the brief). Same as above by default, so it's a no-op
# until you change FILAC_BACKEND.
FILAC_FALLBACK_BACKEND=claude-cli
FILAC_FALLBACK_MODEL=claude-opus-5
FILAC_FALLBACK_EFFORT=high

# Only needed with FILAC_BACKEND=api. Get from console.anthropic.com.
ANTHROPIC_API_KEY=

# Only needed with FILAC_BACKEND=lmstudio. Load a model in LM Studio, start its local server,
# then set FILAC_MODEL to the id GET {LMSTUDIO_BASE_URL}/models reports (e.g. qwen/qwen3.8-27b).
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MAX_TOKENS=8000

# Scenario fingerprinting (Phase 6). Scenarios are short, so the local backend is the default.
FINGERPRINT_BACKEND=lmstudio
FINGERPRINT_MODEL=qwen/qwen3.8-27b
FINGERPRINT_EFFORT=low

# If LM Studio isn't running or errors, fall back here automatically (Sonnet via claude-cli —
# cheap cloud option, the default before local was proven out).
FINGERPRINT_FALLBACK_BACKEND=claude-cli
FINGERPRINT_FALLBACK_MODEL=claude-sonnet-5
FINGERPRINT_FALLBACK_EFFORT=low

# Scenario file uploads (Phase 6). Bucket is created automatically on first use.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=scenario-uploads
MINIO_SECURE=false

# Needed from Phase 7. Apply via the CanLII feedback form.
CANLII_API_KEY=
